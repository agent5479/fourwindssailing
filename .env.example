# Copy to .env.local for local development.

# Canonical site origin (no trailing slash)
VITE_SITE_URL=https://fourwindssailing.nz

# Asset/base path. Custom domain uses `/` (default). Only set a subpath for project-page testing:
# VITE_BASE=/fourwindssailing/

# Google Search Console — paste the content value from the HTML-tag verification method
# VITE_GOOGLE_SITE_VERIFICATION=your_token_here

# Optional Google Apps Script booking endpoint. Leave unset to use illustrative availability
# plus FormSubmit enquiry delivery to Tom’s email.
# VITE_FORM_ENDPOINT=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
