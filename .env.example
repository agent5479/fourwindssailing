# Copy to .env.local for local development.

# Canonical site origin (no trailing slash). CI sets the GitHub Pages URL.
VITE_SITE_URL=https://agent5479.github.io/fourwindssailing

# Project-page base path for GitHub Pages (include trailing slash). Leave unset for local `/`.
# VITE_BASE=/fourwindssailing/

# Google Search Console — paste the content value from the HTML-tag verification method
# VITE_GOOGLE_SITE_VERIFICATION=your_token_here

# Optional Google Apps Script booking endpoint. Leave unset to use local mock availability.
# VITE_FORM_ENDPOINT=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
